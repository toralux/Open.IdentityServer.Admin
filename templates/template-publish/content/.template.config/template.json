{
  "$schema": "http://json.schemastore.org/template",
  "author": "Jan Skoruba",
  "classifications": ["Web", "Open IdentityServer", "Admin"],
  "name": "Toralux Open.IdentityServer Admin",
  "identity": "Toralux.Open.IdentityServer.Admin",
  "groupIdentity": "Toralux.Open.IdentityServer.Admin",
  "shortName": "toralux.open-isadmin",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "ToraluxOpen.IdentityServerAdmin",
  "preferNameDirectory": true,
  "symbols": {
    "title": {
      "type": "parameter",
      "defaultValue": "Toralux Open IdentityServer Admin",
      "replaces": "Toralux Open IdentityServer Admin",
      "isRequired": true,
      "description": "The title and footer of the Admin UI"
    },
    "adminpassword": {
      "type": "parameter",
      "defaultValue": "Passw0rd-123",
      "replaces": "Passw0rd-123",
      "isRequired": true,
      "description": "The admin password, that is used to first login (default is Passw0rd-123)."
    },
    "adminemail": {
      "type": "parameter",
      "defaultValue": "admin@example.com",
      "replaces": "admin@example.com",
      "isRequired": true,
      "description": "The admin email."
    },
    "adminrole": {
      "type": "parameter",
      "defaultValue": "ToraluxIdentityAdminAdministrator",
      "replaces": "ToraluxIdentityAdminAdministrator",
      "isRequired": true,
      "description": "The name of admin role, that is used to authorize the administration (for example: MyAdminRole)."
    },
    "adminclientid": {
      "type": "parameter",
      "defaultValue": "toralux_identity_admin_v3",
      "replaces": "toralux_identity_admin_v3",
      "isRequired": true,
      "description": "The name of client, that is used in the Open IdentityServer"
    },
    "adminclientsecret": {
      "type": "parameter",
      "defaultValue": "toralux_admin_client_secret",
      "replaces": "toralux_admin_client_secret",
      "isRequired": true,
      "description": "The value of client secret, that is used in the Open IdentityServer"
    },
    "dockersupport": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "isRequired": true,
      "description": "Add docker support for Admin UI"
    },
    "requirepushedauthorization": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Set RequirePushedAuthorization on the admin client."
    },
    "admindevport": {
      "type": "parameter",
      "defaultValue": "localhost:7127",
      "replaces": "localhost:50445",
      "description": "The port number for the Admin project when running in development."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!dockersupport)",
          "exclude": [
            "shared/**",
            "docker-compose.dcproj",
            ".dockerignore",
            "docker-compose.yml",
            "docker-compose.override.yml",
            "src/ToraluxOpen.IdentityServerAdmin.Admin/Dockerfile",
            "src/ToraluxOpen.IdentityServerAdmin.Admin.Api/Dockerfile",
            "src/ToraluxOpen.IdentityServerAdmin.STS.Identity/Dockerfile",
            "ToraluxOpen.IdentityServerAdmin.AdminUI.sln"
          ]
        },
        {
          "condition": "(dockersupport)",
          "exclude": ["ToraluxOpen.IdentityServerAdmin.Admin.sln"]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "src/ToraluxOpen.IdentityServerAdmin.Admin/ToraluxOpen.IdentityServerAdmin.Admin.csproj"
    },
    {
      "path": "src/ToraluxOpen.IdentityServerAdmin.STS.Identity/ToraluxOpen.IdentityServerAdmin.STS.Identity.csproj"
    },
    {
      "path": "src/ToraluxOpen.IdentityServerAdmin.Admin.Api/ToraluxOpen.IdentityServerAdmin.Admin.Api.csproj"
    },
    {
      "path": "src/ToraluxOpen.IdentityServerAdmin.Admin.EntityFramework.Shared/ToraluxOpen.IdentityServerAdmin.Admin.EntityFramework.Shared.csproj"
    },
    {
      "path": "src/ToraluxOpen.IdentityServerAdmin.Admin.EntityFramework.PostgreSQL/ToraluxOpen.IdentityServerAdmin.Admin.EntityFramework.PostgreSQL.csproj"
    },
    {
      "path": "src/ToraluxOpen.IdentityServerAdmin.Admin.EntityFramework.SqlServer/ToraluxOpen.IdentityServerAdmin.Admin.EntityFramework.SqlServer.csproj"
    },
    {
      "path": "src/ToraluxOpen.IdentityServerAdmin.Shared/ToraluxOpen.IdentityServerAdmin.Shared.csproj"
    }
  ],
  "postActions": [
    {
      "actionId": "D396686C-DE0E-4DE6-906D-291CD29FC5DE",
      "args": {
        "primaryOutputIndexes": "0;1;2;3;4;5;6"
      },
      "continueOnError": false,
      "manualInstructions": [
        {
          "text": "Add projects to solution."
        }
      ]
    },
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ],
  "specialCustomOperations": {
    "**/*.json": {
      "operations": [
        {
          "type": "replacement",
          "condition": "(!requirepushedauthorization)",
          "configuration": {
            "original": "\"RequirePushedAuthorization\": true",
            "replacement": "\"RequirePushedAuthorization\": false"
          }
        },
        {
          "type": "replacement",
          "condition": "(requirepushedauthorization)",
          "configuration": {
            "original": "\"RequirePushedAuthorization\": false",
            "replacement": "\"RequirePushedAuthorization\": true"
          }
        }
      ]
    }
  }
}

@model string

@if (!String.IsNullOrEmpty(Model))
{
    const string errorPrefix = "Error: ";
    var isError = Model.StartsWith(errorPrefix, StringComparison.OrdinalIgnoreCase);
    var statusMessageClass = isError ? "alert-destructive" : "alert-default";
    var iconName = isError ? "alert-circle" : "check";
    var displayText = isError ? Model[errorPrefix.Length..] : Model;
    <div class="@statusMessageClass mb-4">
        <lucideicon name="@iconName" class="h-4 w-4" />
        <div>
            <div class="alert-description">@displayText</div>
        </div>
    </div>
}